# Client-side, public Supabase credentials (already used in Phase 2):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# SERVER-ONLY secrets: allowed in .env.local (which is gitignored).
# Never prefix these with NEXT_PUBLIC_. Never commit/share them.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVER_SECRET_KEY
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_32_CHARACTER_SECRET

# UUID of the ONE business whose Telegram bot this local MVP serves.
# Supabase Table Editor -> public.businesses -> id
TELEGRAM_BUSINESS_ID=YOUR_BUSINESS_UUID

# Phase 3B: Gemini API key (server-only; NEVER use NEXT_PUBLIC_)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional. Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Messenger: one-time platform configuration, not per-customer credentials.
# Customer Page tokens are obtained via Facebook login and encrypted in the database.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
# Optional Facebook Login for Business configuration (User access token flow).
META_LOGIN_CONFIG_ID=
SUPPORTFLOW_APP_URL=https://your-production-domain.example
